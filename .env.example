# Google Gemini API key, used for AI-assisted campaign analysis.
GEMINI_API_KEY=

# Gemini model used for qualitative review. Optional — defaults to
# gemini-2.5-flash if unset.
GEMINI_MODEL=gemini-2.5-flash

# Make (Integromat) webhook URL, used to trigger and receive automation events.
MAKE_WEBHOOK_URL=

# Per-attempt HTTP timeout (seconds) for the Make webhook call. Optional —
# defaults to 5 if unset.
MAKE_WEBHOOK_TIMEOUT_SECONDS=5

# Total delivery attempts (first attempt plus retries) for the Make
# webhook call. Optional — defaults to 2 if unset.
MAKE_WEBHOOK_MAX_ATTEMPTS=2

# Slack incoming webhook URL, used to send QA result notifications.
SLACK_WEBHOOK_URL=
